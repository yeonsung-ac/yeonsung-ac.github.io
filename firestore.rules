rules_version = '2';

// 연성대학교 이현구 교수 홈페이지 통합 Firestore 규칙
//
// Firebase 프로젝트 하나를 여러 곳이 함께 쓴다.
//   posts        - 홈페이지 게시판     (yeonsung-ac.github.io/board/)
//   applications - 부트캠프 간편 신청  (yeonsung-ac.github.io/YouthLeap/)
//   secrets      - 비밀글 본문         (게시판의 과제 분류 전용)
//   submissions  - 과제 제출함         (yeonsung-ac.github.io/submit/)
//
// 이 파일 전체를 Firebase 콘솔 > Firestore Database > 규칙 탭에 붙여넣고 게시하세요.
// 일부만 넣으면 나머지가 동작하지 않습니다.
//
// ⚠ 아래 PASTE_PROFESSOR_UID_HERE 를 교수 계정의 실제 UID 로 바꿔야 제출물 전체 열람이 됩니다.
//   값은 Firebase 콘솔 > Authentication > 사용자 탭의 '사용자 UID' 열에서 복사합니다.
//   submit/settings.js, storage.rules 의 값과 반드시 같아야 합니다.

service cloud.firestore {
  match /databases/{database}/documents {

    function isProfessor() {
      return request.auth != null
        && request.auth.uid == 'PASTE_PROFESSOR_UID_HERE';
    }

    // ---------- 홈페이지 게시판 ----------
    // 읽기는 누구나, 쓰기는 로그인 사용자, 수정은 본인 글만.
    //
    // 비밀글은 '과제' 분류에서만 쓸 수 있다. Firestore 는 문서 단위로만 권한을 걸 수 있어
    // 한 문서 안에서 제목만 공개하고 본문만 가릴 수 없다. 그래서 비밀글의 본문은
    // 아래 secrets 컬렉션에 따로 두고, posts 에는 빈 content 만 남긴다.
    // 덕분에 목록에는 제목이 다 보이고 본문만 잠긴다.
    function bodyPlacedCorrectly(data) {
      return data.secret == false
        ? data.content.size() > 0
        : (data.category == '과제' && data.content == '');
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 8000
        && request.resource.data.secret is bool
        && bodyPlacedCorrectly(request.resource.data)
        && request.resource.data.category in ['자유', '질문', '후기', '과제', '공지'];

      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 8000
        && request.resource.data.secret is bool
        && bodyPlacedCorrectly(request.resource.data)
        && request.resource.data.category in ['자유', '질문', '후기', '과제', '공지'];

      // 부적절한 글은 교수도 지울 수 있다.
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isProfessor());
    }

    // ---------- 비밀글 본문 ----------
    // 문서 ID 는 posts 의 글 ID 와 같다. 작성자와 교수만 읽는다.
    match /secrets/{postId} {
      allow read: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isProfessor());

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 8000;

      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 8000;

      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isProfessor());
    }

    // ---------- 부트캠프 간편 신청 ----------
    // 공개 댓글형. 수정은 막아 신청 기록을 남긴 그대로 보존한다.
    match /applications/{applicationId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.kind in ['신청', '문의'];

      allow update: if false;

      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // ---------- 과제 제출함 ----------
    // 학생은 자기가 낸 것만 보고, 교수만 전체를 본다.
    // 학생 화면은 where('ownerId','==',내UID) 로 질의하기 때문에 아래 read 규칙을 통과한다.
    match /submissions/{submissionId} {
      allow read: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isProfessor());

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.assignment is string
        && request.resource.data.assignment.size() > 0
        && request.resource.data.assignment.size() <= 60
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() > 0
        && request.resource.data.fileName.size() <= 260
        && request.resource.data.fileSize is int
        && request.resource.data.fileSize > 0
        && request.resource.data.fileSize <= 50 * 1024 * 1024
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 100
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('submissions/' + request.auth.uid + '/.*');

      // 제출 기록은 고치지 못한다. 다시 내려면 새로 올린다.
      allow update: if false;

      allow delete: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isProfessor());
    }
  }
}
