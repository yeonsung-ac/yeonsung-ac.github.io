rules_version = '2';

// 연성대학교 이현구 교수 홈페이지 통합 Firestore 규칙
//
// Firebase 프로젝트 하나를 여러 곳이 함께 쓴다.
//   posts        - 홈페이지 게시판     (yeonsung-ac.github.io/board/)
//   applications - 부트캠프 간편 신청  (yeonsung-ac.github.io/YouthLeap/)
//   secrets      - 비밀글 본문         (게시판의 상담 분류 전용)
//   submissions  - 과제 제출함         (yeonsung-ac.github.io/submit/)
//   mgmt_quizzes / mgmt_answers / mgmt_log - 경영학원론 수업 퀴즈 (courses/01-management/)
//
// 이 파일 전체를 Firebase 콘솔 > Firestore Database > 규칙 탭에 붙여넣고 게시하세요.
// 일부만 넣으면 나머지가 동작하지 않습니다.
//
// 교수 판별은 구글 로그인 이메일로 한다. 아래 isProfessor() 의 주소 목록과
// professor.js 의 PROFESSOR_EMAILS 가 같아야 한다. 계정을 추가하려면 양쪽에 함께 적는다.

service cloud.firestore {
  match /databases/{database}/documents {

    // 구글이 확인해 준 이메일만 인정한다. email_verified 를 빼면 다른 로그인 수단으로
    // 교수 주소를 사칭할 여지가 생긴다.
    function isProfessor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['dasahee@yeonsung.ac.kr'];
    }

    // ---------- 홈페이지 게시판 ----------
    // 읽기는 누구나, 쓰기는 로그인 사용자, 수정은 본인 글만.
    // 예외로 교수는 남의 글에서 '제목만' 고칠 수 있다(실명 가리기용).
    //
    // 비밀글은 '상담' 분류에서만 쓸 수 있다. Firestore 는 문서 단위로만 권한을 걸 수 있어
    // 한 문서 안에서 제목만 공개하고 본문만 가릴 수 없다. 그래서 비밀글의 본문은
    // 아래 secrets 컬렉션에 따로 두고, posts 에는 빈 content 만 남긴다.
    // 덕분에 목록에는 제목이 다 보이고 본문만 잠긴다.
    function bodyPlacedCorrectly(data) {
      return data.secret == false
        ? data.content.size() > 0
        : (data.category == '상담' && data.content == '');
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 8000
        && request.resource.data.secret is bool
        && bodyPlacedCorrectly(request.resource.data)
        && request.resource.data.category in ['자유', '질문', '후기', '상담', '공지'];

      allow update: if request.auth != null && (
        // 본인 글은 전부 고칠 수 있다.
        ( resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 8000
          && request.resource.data.secret is bool
          && bodyPlacedCorrectly(request.resource.data)
          && request.resource.data.category in ['자유', '질문', '후기', '상담', '공지'] )

        // 학생이 제목에 실명을 그대로 적어 올린 경우가 있다. 교수가 그 이름만
        // 가릴 수 있게 열어 두되, 제목 밖의 값은 하나라도 달라지면 막는다.
        // 그래서 남의 글을 고쳐 쓰거나 분류를 바꾸는 일은 여전히 불가능하다.
        || ( isProfessor()
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.authorName == resource.data.authorName
          && request.resource.data.content == resource.data.content
          && request.resource.data.category == resource.data.category
          && request.resource.data.secret == resource.data.secret
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120 )
      );

      // 부적절한 글은 교수도 지울 수 있다.
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isProfessor());
    }

    // ---------- 비밀글 본문 ----------
    // 문서 ID 는 posts 의 글 ID 와 같다. 작성자와 교수만 읽는다.
    match /secrets/{postId} {
      allow read: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isProfessor());

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 8000;

      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 8000;

      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isProfessor());
    }

    // ---------- 부트캠프 간편 신청 ----------
    // 공개 댓글형. 수정은 막아 신청 기록을 남긴 그대로 보존한다.
    match /applications/{applicationId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.kind in ['신청', '문의'];

      allow update: if false;

      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }


    // ---------- 경영학원론 수업 도우미 ----------
    // 학생은 구글 계정 없이 익명으로 들어온다. 그래도 uid 는 저마다 다르므로
    // '내 답만 내가 낸다'를 서버가 지킬 수 있다. 성명·학번은 그 uid 에 붙는 이름표다.
    //
    //   mgmt_quizzes - 문제. 교수만 만들고 고친다. 열린 것은 누구나 읽는다.
    //   mgmt_answers - 답안. 문서 이름이 '문제ID_uid' 라 한 사람이 두 번 못 낸다.

    match /mgmt_quizzes/{quizId} {
      // 문제를 읽을 수 있어야 풀 수 있다. 정답도 함께 실려 있으나,
      // 어차피 제출하면 바로 보여 주는 값이라 감추지 않는다.
      allow read: if request.auth != null;

      allow create, update, delete: if isProfessor();
    }

    match /mgmt_answers/{answerId} {
      // 자기 답만 읽는다. 교수는 전부 읽는다.
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isProfessor());

      // 문서 이름을 uid 로 묶어 남의 이름으로 내지 못하게 한다.
      allow create: if request.auth != null
        && answerId == request.resource.data.quizId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.sid is string
        && request.resource.data.sid.size() > 0
        && request.resource.data.sid.size() <= 20
        && request.resource.data.picks is list
        && request.resource.data.picks.size() <= 30;

      // 한 번 낸 답은 본인도 못 고친다. 잘못 냈으면 교수가 지워 준다.
      allow update: if false;

      allow delete: if isProfessor();
    }

    match /mgmt_log/{logId} {
      // 제출 자취. 대리 제출을 가려내려고 남긴다. 교수만 읽는다.
      // 학생 화면에서 IP 를 수집한다는 사실을 문패에 밝혀 두었다.
      allow read: if isProfessor();

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sid is string
        && request.resource.data.sid.size() <= 20
        && request.resource.data.ip is string
        && request.resource.data.ip.size() <= 45;

      // 남긴 자취는 아무도 못 고친다. 지우는 것은 교수만.
      allow update: if false;
      allow delete: if isProfessor();
    }

    // ---------- 과제 제출함 ----------
    // 학생은 자기가 낸 것만 보고, 교수만 전체를 본다.
    // 학생 화면은 where('ownerId','==',내UID) 로 질의하기 때문에 아래 read 규칙을 통과한다.
    match /submissions/{submissionId} {
      allow read: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isProfessor());

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.assignment is string
        && request.resource.data.assignment.size() > 0
        && request.resource.data.assignment.size() <= 60
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() > 0
        && request.resource.data.fileName.size() <= 260
        && request.resource.data.fileSize is int
        && request.resource.data.fileSize > 0
        && request.resource.data.fileSize <= 50 * 1024 * 1024
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 100
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('submissions/' + request.auth.uid + '/.*');

      // 올린 파일 자체는 바꿀 수 없다. 잘못 냈으면 지우고 다시 올린다.
      // 다만 과제를 잘못 골랐거나 메모를 고치는 일은 흔하므로 그 둘만 허용한다.
      // 소유자·파일명·크기·저장경로를 그대로 요구해 남의 제출물을 가로챌 수 없게 막는다.
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.storagePath == resource.data.storagePath
        && request.resource.data.fileName == resource.data.fileName
        && request.resource.data.fileSize == resource.data.fileSize
        && request.resource.data.assignment is string
        && request.resource.data.assignment.size() > 0
        && request.resource.data.assignment.size() <= 60
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 100;

      allow delete: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isProfessor());
    }
  }
}
