rules_version = '2';

// 연성대학교 이현구 교수 홈페이지 Storage 규칙
//
// 과제 제출함(yeonsung-ac.github.io/submit/)이 쓰는 파일 보관 규칙이다.
// 이 파일 전체를 Firebase 콘솔 > Storage > 규칙 탭에 붙여넣고 게시하세요.
//
// 교수 판별은 구글 로그인 이메일로 한다. 아래 isProfessor() 의 주소 목록과
// professor.js 의 PROFESSOR_EMAILS 가 같아야 한다. 계정을 추가하려면 양쪽에 함께 적는다.

service firebase.storage {
  match /b/{bucket}/o {

    // 구글이 확인해 준 이메일만 인정한다.
    function isProfessor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['dasahee@yeonsung.ac.kr'];
    }

    // 파일 하나당 최대 크기. submit/settings.js 의 MAX_FILE_MB 와 같은 값이어야 한다.
    function withinSizeLimit() {
      return request.resource == null || request.resource.size <= 50 * 1024 * 1024;
    }

    // submissions/{학생UID}/{임의ID}/{파일명}
    match /submissions/{ownerId}/{allPaths=**} {

      // 본인 것과 교수만 내려받을 수 있다. 학생끼리는 서로 못 본다.
      allow read: if request.auth != null
        && (request.auth.uid == ownerId || isProfessor());

      // 올리기·덮어쓰기·지우기. 삭제 요청에는 request.resource 가 없다.
      allow write: if isProfessor()
        || (request.auth != null && request.auth.uid == ownerId && withinSizeLimit());
    }

    // mgmt_intros/{학생UID}/photo.jpg - 경영학원론 자기소개 사진.
    // 브라우저에서 긴 변 1600px JPEG 으로 줄여 올리므로 한 장이 1MB 를 넘지 않는다.
    // 넉넉히 5MB 까지만 받는다. 낸 사람과 교수만 본다.
    match /mgmt_intros/{ownerId}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.uid == ownerId || isProfessor());

      allow write: if isProfessor()
        || (request.auth != null && request.auth.uid == ownerId
            && (request.resource == null
                || (request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*'))));
    }

    // 위에서 허용하지 않은 경로는 전부 막는다.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
