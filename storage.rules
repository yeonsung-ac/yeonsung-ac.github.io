rules_version = '2';

// 연성대학교 이현구 교수 홈페이지 Storage 규칙
//
// 과제 제출함(yeonsung-ac.github.io/submit/)이 쓰는 파일 보관 규칙이다.
// 이 파일 전체를 Firebase 콘솔 > Storage > 규칙 탭에 붙여넣고 게시하세요.
//
// ⚠ 아래 PROFESSOR_UID 를 교수 계정의 실제 UID 로 바꿔야 전체 열람이 됩니다.
//   값은 Firebase 콘솔 > Authentication > 사용자 탭의 '사용자 UID' 열에서 복사합니다.
//   submit/settings.js 의 PROFESSOR_UID 와 반드시 같은 값이어야 합니다.

service firebase.storage {
  match /b/{bucket}/o {

    function isProfessor() {
      return request.auth != null
        && request.auth.uid == 'PASTE_PROFESSOR_UID_HERE';
    }

    // 파일 하나당 최대 크기. submit/settings.js 의 MAX_FILE_MB 와 같은 값이어야 한다.
    function withinSizeLimit() {
      return request.resource == null || request.resource.size <= 50 * 1024 * 1024;
    }

    // submissions/{학생UID}/{임의ID}/{파일명}
    match /submissions/{ownerId}/{allPaths=**} {

      // 본인 것과 교수만 내려받을 수 있다. 학생끼리는 서로 못 본다.
      allow read: if request.auth != null
        && (request.auth.uid == ownerId || isProfessor());

      // 올리기·덮어쓰기·지우기. 삭제 요청에는 request.resource 가 없다.
      allow write: if isProfessor()
        || (request.auth != null && request.auth.uid == ownerId && withinSizeLimit());
    }

    // 위에서 허용하지 않은 경로는 전부 막는다.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
